<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/top"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginHorizontal="4dp"
    android:layout_marginVertical="4dp"
    android:background="@drawable/bg_card20"
    android:clickable="true"
    android:focusable="true"
    android:gravity="center_vertical"
    android:orientation="horizontal"
    android:padding="14dp"
    android:stateListAnimator="@animator/press_scale">

    <ImageView
        android:id="@+id/book_cover"
        android:layout_width="48dp"
        android:layout_height="64dp"
        android:scaleType="centerCrop"
        android:src="@drawable/epub" />

    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="14dp"
        android:layout_weight="1"
        android:orientation="vertical">

        <TextView
            android:id="@+id/book_title"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:ellipsize="end"
            android:fontFamily="@font/jakarta_bold"
            android:maxLines="2"
            android:textColor="@color/brand_text"
            android:textSize="16sp" />

        <TextView
            android:id="@+id/book_modififed"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:fontFamily="@font/jakarta_medium"
            android:maxLines="1"
            android:textColor="@color/brand_textMuted"
            android:textSize="13sp" />
    </LinearLayout>
</LinearLayout>
