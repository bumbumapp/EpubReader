<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/brand_ground"
    android:orientation="vertical">

    <!-- Kept for the privacy-options menu item; the large title below names the screen. -->
    <androidx.appcompat.widget.Toolbar
        android:id="@+id/toolbar"
        android:layout_width="match_parent"
        android:layout_height="48dp"
        android:background="@android:color/transparent" />

    <androidx.core.widget.NestedScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:fillViewport="true">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

    <TextView
        android:id="@+id/home_greeting"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginHorizontal="20dp"
        android:fontFamily="@font/jakarta_medium"
        android:text="@string/bento_greeting_evening"
        android:textColor="@color/brand_textMuted"
        android:textSize="15sp" />

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginHorizontal="20dp"
        android:layout_marginTop="2dp"
        android:fontFamily="@font/jakarta_extrabold"
        android:letterSpacing="-0.03"
        android:text="@string/bento_home_title"
        android:textColor="@color/brand_text"
        android:textSize="32sp" />

    <!-- Hero tile: the whole accent tile opens a book. -->
    <LinearLayout
        android:id="@+id/btn_raw"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginHorizontal="20dp"
        android:layout_marginTop="18dp"
        android:background="@drawable/bg_hero"
        android:clickable="true"
        android:focusable="true"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:padding="20dp"
        android:stateListAnimator="@animator/press_scale">

        <FrameLayout
            android:layout_width="62dp"
            android:layout_height="52dp">

            <View
                android:layout_width="34dp"
                android:layout_height="44dp"
                android:layout_gravity="center_vertical"
                android:layout_marginStart="26dp"
                android:alpha="0.5"
                android:background="@drawable/bg_page_white"
                android:rotation="10" />

            <View
                android:layout_width="34dp"
                android:layout_height="44dp"
                android:layout_gravity="center_vertical"
                android:layout_marginStart="13dp"
                android:alpha="0.75"
                android:background="@drawable/bg_page_white"
                android:rotation="3" />

            <View
                android:layout_width="34dp"
                android:layout_height="44dp"
                android:layout_gravity="center_vertical"
                android:background="@drawable/bg_page_white"
                android:rotation="-7" />
        </FrameLayout>

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="14dp"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:fontFamily="@font/jakarta_bold"
                android:letterSpacing="-0.02"
                android:text="@string/home_open_book"
                android:textColor="@color/brand_onInk"
                android:textSize="21sp" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:alpha="0.85"
                android:fontFamily="@font/jakarta_medium"
                android:text="@string/bento_hero_subtitle"
                android:textColor="@color/brand_onInk"
                android:textSize="14sp" />
        </LinearLayout>

        <ImageView
            android:layout_width="44dp"
            android:layout_height="44dp"
            android:background="@drawable/bg_hero_plus"
            android:importantForAccessibility="no"
            android:padding="11dp"
            android:src="@drawable/ic_open_book"
            android:tint="@color/brand_onInk" />
    </LinearLayout>

    <!-- Feature tiles -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginHorizontal="20dp"
        android:layout_marginTop="12dp"
        android:baselineAligned="false"
        android:orientation="horizontal">

        <LinearLayout
            android:id="@+id/tile_bookmarks"
            style="@style/BentoTile"
            android:layout_marginEnd="6dp">

            <ImageView style="@style/BentoTileIcon" android:src="@drawable/ic_bookmark" />

            <TextView style="@style/BentoTileTitle" android:text="@string/tile_bookmarks" />

            <TextView
                android:id="@+id/tile_bookmarks_sub"
                style="@style/BentoTileSub" />
        </LinearLayout>

        <LinearLayout
            android:id="@+id/tile_highlights"
            style="@style/BentoTile"
            android:layout_marginHorizontal="6dp">

            <ImageView style="@style/BentoTileIcon" android:src="@drawable/ic_highlight" />

            <TextView style="@style/BentoTileTitle" android:text="@string/tile_highlights" />

            <TextView
                android:id="@+id/tile_highlights_sub"
                style="@style/BentoTileSub" />
        </LinearLayout>

        <LinearLayout
            android:id="@+id/tile_stats"
            style="@style/BentoTile"
            android:layout_marginStart="6dp">

            <ImageView style="@style/BentoTileIcon" android:src="@drawable/ic_chart" />

            <TextView style="@style/BentoTileTitle" android:text="@string/tile_stats" />

            <TextView
                android:id="@+id/tile_stats_sub"
                style="@style/BentoTileSub" />
        </LinearLayout>
    </LinearLayout>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="16dp"
        android:layout_marginBottom="6dp"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="20dp"
            android:layout_weight="1"
            android:fontFamily="@font/jakarta_bold"
            android:text="@string/home_books"
            android:textColor="@color/brand_text"
            android:textSize="17sp" />

    <TextView
                android:id="@+id/sort_button"
                android:layout_width="wrap_content"
                android:layout_height="40dp"
                android:layout_marginEnd="20dp"
                android:background="@drawable/bg_chip_off"
                android:clickable="true"
                android:focusable="true"
                android:fontFamily="@font/jakarta_semibold"
                android:gravity="center"
                android:minWidth="48dp"
                android:paddingHorizontal="14dp"
                android:textColor="@color/brand_text"
                android:textSize="13sp" />
    </LinearLayout>

    <LinearLayout
        android:id="@+id/library_tools"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical">

        <EditText
            android:id="@+id/search_books"
            android:layout_width="match_parent"
            android:layout_height="46dp"
            android:layout_marginHorizontal="20dp"
            android:background="@drawable/bg_card20"
            android:drawableStart="@drawable/ic_search_small"
            android:drawablePadding="10dp"
            android:fontFamily="@font/jakarta_medium"
            android:hint="@string/search_books_hint"
            android:imeOptions="actionSearch"
            android:importantForAutofill="no"
            android:inputType="text"
            android:maxLines="1"
            android:paddingHorizontal="14dp"
            android:textColor="@color/brand_text"
            android:textColorHint="@color/brand_textMuted"
            android:textSize="15sp" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <HorizontalScrollView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:scrollbars="none">

                <LinearLayout
                    android:id="@+id/filter_chips"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:paddingStart="20dp"
                    android:paddingEnd="8dp" />
            </HorizontalScrollView>


        </LinearLayout>
    </LinearLayout>

    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/book_epubs"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:clipToPadding="false"
        android:nestedScrollingEnabled="false"
        android:paddingHorizontal="16dp"
        android:paddingBottom="16dp" />

    <LinearLayout
        android:id="@+id/toDoEmptyView"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_horizontal"
        android:orientation="vertical"
        android:paddingHorizontal="40dp"
        android:paddingTop="24dp"
        android:paddingBottom="32dp"
        android:visibility="gone">

        <ImageView
            android:layout_width="72dp"
            android:layout_height="72dp"
            android:background="@drawable/bg_round12_accent"
            android:importantForAccessibility="no"
            android:padding="16dp"
            android:src="@drawable/epub" />

        <TextView
            android:id="@+id/empty_title"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:fontFamily="@font/jakarta_bold"
            android:text="@string/home_empty_title"
            android:textColor="@color/brand_text"
            android:textSize="17sp" />

        <TextView
            android:id="@+id/empty_body"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:fontFamily="@font/jakarta_medium"
            android:gravity="center"
            android:text="@string/home_empty_body"
            android:textColor="@color/brand_textMuted"
            android:textSize="14sp" />
    </LinearLayout>
        </LinearLayout>
    </androidx.core.widget.NestedScrollView>

    <FrameLayout
        android:id="@+id/adView"
        android:layout_width="match_parent"
        android:layout_height="wrap_content" />
</LinearLayout>
